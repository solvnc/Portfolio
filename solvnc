.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.chip{background:none;border:1px solid var(--line);color:var(--muted);padding:6px 14px;border-radius:99px;cursor:pointer;font:inherit;font-size:.82rem}
.chip.on,.chip:hover{border-color:var(--accent);color:var(--accent)}
.skills{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.skill{padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--panel);font-size:.9rem;transition:.2s}
.skill{display:flex;align-items:center;gap:10px}
.ic{width:48px;height:48px;border-radius:12px;background:#0d1522;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;flex:none;transition:.25s}
.skill:hover .ic{transform:scale(1.12) rotate(-4deg);border-color:var(--accent);box-shadow:0 0 16px rgba(0,229,168,.3)}
.sn{display:flex;flex-direction:column;line-height:1.25;font-size:.85rem}
.sn small{color:var(--muted);font-size:.68rem;margin-top:2px}
.skill:hover{border-color:var(--accent);transform:translateY(-2px)}
.skill.hide{display:none}
.proj{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.pc{cursor:pointer;transition:.25s;position:relative}
.pc:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:0 8px 30px rgba(0,229,168,.12)}
.pc.feat{grid-column:1/-1;border-color:var(--accent);background:linear-gradient(135deg,#0f1c24,var(--panel))}
.tag{font-size:.7rem;color:var(--accent);border:1px solid var(--accent);border-radius:99px;padding:2px 10px}
.pc h3{margin:10px 0 6px}
.pc p{color:var(--muted);margin:0 0 12px;font-size:.92rem}
.stack{display:flex;gap:6px;flex-wrap:wrap}
.stack span{font-size:.72rem;background:#16223a;color:var(--accent2);padding:2px 8px;border-radius:4px}
.more{max-height:0;overflow:hidden;transition:max-height .4s;color:var(--text);font-size:.9rem}
.pc.open .more{max-height:420px;margin-top:12px}
.more li{margin:4px 0}
.hint{font-size:.75rem;color:var(--muted);margin-top:10px}
.about{display:grid;grid-template-columns:210px 1fr;gap:28px;align-items:center}
@media(max-width:640px){.about{grid-template-columns:1fr;justify-items:center;text-align:left}}
.photo{width:200px;height:200px;border-radius:16px;border:2px solid var(--accent);box-shadow:0 0 28px rgba(0,229,168,.2);overflow:hidden;display:flex;align-items:center;justify-content:center;background:#0d1522;color:var(--muted);font-size:.8rem;text-align:center}
.photo img{width:100%;height:100%;object-fit:cover}
.shots{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin-bottom:14px}
.shot{aspect-ratio:16/10;border-radius:8px;border:1px dashed var(--line);background:#0d1522;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.7rem;overflow:hidden}
.shot img{width:100%;height:100%;object-fit:cover;cursor:zoom-in;transition:.25s}
.shot img:hover{transform:scale(1.06)}
#lb{position:fixed;inset:0;background:rgba(0,0,0,.88);display:none;align-items:center;justify-content:center;z-index:20;padding:20px;cursor:zoom-out}
#lb.show{display:flex}
#lb img{max-width:100%;max-height:100%;border-radius:10px}
.tl{border-left:2px solid var(--line);padding-left:20px}
.tl .item{position:relative;margin-bottom:24px}
.tl .item::before{content:'';position:absolute;left:-27px;top:7px;width:12px;height:12px;border-radius:50%;background:var(--accent)}
.tl small{color:var(--muted)}
.acts{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;margin-top:14px}
.act{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:.88rem;color:var(--muted);transition:.2s}
.act b{display:block;color:var(--accent);font-size:.82rem;margin-bottom:4px}
.act:hover{border-color:var(--accent);transform:translateY(-2px)}
.certs ul{margin:8px 0 0;padding-left:18px;color:var(--muted);font-size:.85rem}
.certs{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
.certs .card{font-size:.92rem}
.certs .card b{display:block;color:var(--accent)}
.contact{text-align:center}
.contact a.mail{color:var(--accent);text-decoration:none}
.contact a.mail:hover{text-decoration:underline}
.soc{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:12px}
.soc a{color:var(--muted);text-decoration:none;border:1px solid var(--line);padding:8px 16px;border-radius:8px}
.soc a:hover{color:var(--accent);border-color:var(--accent)}
footer{text-align:center;color:var(--muted);font-size:.8rem;padding:60px 5vw 40px}
#hero{position:relative}
.robo{display:block;overflow:visible;width:100%}
.robo *{transform-box:fill-box}
.bulb,.blink{animation:bulb 1.2s infinite}
@keyframes bulb{50%{opacity:.25}}
.blink.b2{animation-delay:.4s}
.head{transform-origin:50% 100%;transition:transform .3s}
.robo:hover .head{transform:rotate(-6deg)}
.armL,.armR{transform-origin:50% 8%}
.wave .armR{animation:wvR .35s 7 alternate ease-in-out}
.wave .armL{animation:wvL .35s 7 alternate ease-in-out .1s}
@keyframes wvR{to{transform:rotate(-140deg)}}
@keyframes wvL{to{transform:rotate(140deg)}}
.wheel{transform-origin:center}
.on .wheel,.rolling .wheel{animation:rot .5s linear infinite}
.rev .wheel{animation-direction:reverse}
@keyframes rot{to{transform:rotate(360deg)}}
.on .lg.a,.crawl .lg.a{animation:lga .22s infinite alternate}
.on .lg.b,.crawl .lg.b{animation:lgb .22s infinite alternate}
@keyframes lga{to{transform:translateY(-3px) rotate(10deg)}}
@keyframes lgb{to{transform:translateY(-3px) rotate(-10deg)}}
.flame{transform-origin:50% 0;animation:fl .15s infinite alternate}
@keyframes fl{to{transform:scaleY(1.45)}}
.prop{transform-origin:center;animation:prp .1s linear infinite alternate}
@keyframes prp{from{transform:scaleX(.2)}to{transform:scaleX(1)}}
.on{animation:wig .35s infinite alternate}
@keyframes wig{to{transform:rotate(5deg)}}
.jump{animation:jmp .6s}
@keyframes jmp{40%{transform:translateY(-36px) rotate(-8deg)}70%{transform:translateY(0)}85%{transform:translateY(-6px)}}
.dance{animation:dnc .5s 4}
@keyframes dnc{25%{transform:rotate(-8deg) translateY(-8px)}75%{transform:rotate(8deg) translateY(-8px)}}
.spin{animation:spn .7s}
@keyframes spn{to{transform:rotate(360deg) scale(1.1)}}
@keyframes flt{50%{transform:translateY(-14px)}}
.heroBot{position:absolute;right:5vw;top:12%;width:min(224px,28vw);cursor:pointer;animation:flt 3.5s ease-in-out infinite}
#hero>*{max-width:calc(100% - min(260px,30vw))}
#hero>.heroBot{max-width:none}
@media(max-width:700px){#hero>*{max-width:none}.heroBot{position:static;align-self:flex-end;width:80px;margin:0 0 8px}#arm{display:none}}
.sbot{display:inline-block;vertical-align:middle;margin-left:12px;width:48px;cursor:pointer}
.fixbot{position:fixed;left:0;top:0;z-index:6;cursor:pointer}
.sp{width:64px}.wb{width:64px}.sc{width:80px}.dn{width:72px}.rk{width:48px}.pk{width:64px}
.dn .robo{animation:flt 2.2s ease-in-out infinite}
.sc .robo{animation:flt 2.8s ease-in-out infinite}
.pk{transition:transform .7s cubic-bezier(.3,1.4,.5,1)}
#arm{position:fixed;left:0;bottom:env(safe-area-inset-bottom,0px);width:200px;height:200px;z-index:6;pointer-events:none}
.army{display:flex;justify-content:center;gap:14px;margin-bottom:18px}
.army>div{width:48px;cursor:pointer}
.bubble{position:fixed;z-index:30;background:var(--accent);color:#04120d;padding:6px 12px;border-radius:12px;font-size:.78rem;max-width:230px;pointer-events:none;transition:opacity .5s}
.bubble.out{opacity:0}
@media(prefers-reduced-motion:reduce){.robo,.robo *,.heroBot{animation:none!important}}
body{overflow-x:clip;background-image:linear-gradient(rgba(31,42,61,.32) 1px,transparent 1px),linear-gradient(90deg,rgba(31,42,61,.32) 1px,transparent 1px);background-size:48px 48px;background-attachment:fixed}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(600px 420px at 15% 20%,rgba(0,229,168,.09),transparent 70%),radial-gradient(520px 420px at 85% 70%,rgba(77,163,255,.09),transparent 70%);animation:aur 14s ease-in-out infinite alternate}
@keyframes aur{to{transform:translate(3%,4%) scale(1.12)}}
.burger{display:none;background:none;border:1px solid var(--line);color:var(--accent);border-radius:8px;padding:6px 14px;font-size:1.05rem;cursor:pointer}
@media(max-width:700px){
nav{flex-wrap:wrap;padding:10px 5vw}
.burger{display:block}
