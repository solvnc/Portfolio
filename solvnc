}

/* pixel-art robots */
.robo{shape-rendering:crispEdges;image-rendering:pixelated}
#arm{shape-rendering:crispEdges}#arm line{stroke-linecap:butt}
.on .wheel,.rolling .wheel{animation:rot .6s steps(8) infinite}
.on .lg.a,.crawl .lg.a{animation:lga .2s steps(1,end) infinite alternate}
.on .lg.b,.crawl .lg.b{animation:lgb .2s steps(1,end) infinite alternate}
@keyframes lga{to{transform:translateY(-4px)}}
@keyframes lgb{to{transform:translateY(4px)}}
.flame{animation:fl .18s steps(1,end) infinite alternate}
@keyframes fl{to{transform:scaleY(1.25)}}
.prop{animation:prp .1s steps(1,end) infinite alternate}
@keyframes prp{from{transform:scaleX(.34)}to{transform:scaleX(1)}}
.bulb,.blink{animation:bulb 1s steps(1,end) infinite}
.pc.feat .shots{grid-template-columns:4fr 6fr}
.pc.feat .shot{aspect-ratio:auto;height:clamp(130px,22vw,230px)}
.photo img{object-position:center}

/* fonts: pixel display + clean body + mono */
h1,h2,h3,.tag,nav b,.btn,.chip{font-family:'Pixelify Sans','JetBrains Mono',ui-monospace,monospace}
#hero h1{font-weight:700;letter-spacing:.5px;font-size:clamp(2rem,5.4vw,3.7rem)}
h2{font-size:1.9rem;font-weight:600;letter-spacing:.5px}
h2::before{font-family:'Pixelify Sans',monospace}
.pc h3{font-size:1.35rem;font-weight:600}
.btn{font-size:1rem;font-weight:600;letter-spacing:.3px}
nav b{font-size:1.15rem}
@media(max-width:700px){h2{font-size:1.5rem}}
.so2{height:.78em;width:auto;fill:currentColor;stroke:currentColor;stroke-width:.5;shape-rendering:crispEdges;vertical-align:baseline;margin-left:.08em}

/* lightbox: fade/zoom in once, then fully still */
#lb{backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
#lb.show{animation:lbBg .28s ease-out}
#lb.show img{animation:lbImg .38s cubic-bezier(.2,.9,.3,1);border:2px solid var(--accent);box-shadow:0 0 40px rgba(0,229,168,.25)}
@keyframes lbBg{from{opacity:0}to{opacity:1}}
@keyframes lbImg{from{opacity:0;transform:scale(.82) translateY(14px)}to{opacity:1;transform:none}}

/* hanging interactive items (scroll away with the page) */
.hang{position:absolute;top:0;transform-origin:50% 0;z-index:6;pointer-events:none;will-change:transform}
.hang .cab{position:absolute;top:0;width:4px;background:repeating-linear-gradient(#8394ad 0 4px,transparent 4px 8px)}
