.hsign{width:166px;padding:8px 8px 7px;text-align:center;font-family:'Pixelify Sans','JetBrains Mono',monospace;font-size:.88rem;font-weight:600;letter-spacing:.3px;white-space:nowrap;color:var(--accent);background:var(--panel);border:3px solid var(--accent);box-shadow:4px 4px 0 rgba(0,229,168,.25);user-select:none}
.hsign i{display:inline-block;width:8px;height:8px;background:#27c93f;margin-right:7px;vertical-align:1px;animation:bulb 1s steps(1) infinite}
.hlamp .lbulb rect{fill:#3a3f4d}
.hlamp.lit .lbulb rect{fill:#ffe066}
.hlamp .glow{position:absolute;left:50%;top:44px;width:260px;height:230px;margin-left:-130px;background:radial-gradient(ellipse at 50% 0,rgba(255,224,102,.3),rgba(255,224,102,0) 72%);clip-path:polygon(38% 0,62% 0,100% 100%,0 100%);opacity:0;transition:opacity .3s;pointer-events:none}
.hlamp.lit .glow{opacity:1}
.hsign.sm{width:122px;font-size:.66rem;padding:6px 4px 5px;border-width:2px;box-shadow:3px 3px 0 rgba(0,229,168,.25)}
.hsign.sm i{width:6px;height:6px;margin-right:5px}
body.menuopen .hang{display:none}
@media(min-width:701px) and (max-width:900px){.h-lamp,.h-sign{display:none}}

/* scrollable skills + experience */
.skills,.acts{max-height:360px;overflow-y:auto;overscroll-behavior:contain;padding:4px 8px 28px 2px;scrollbar-width:thin;scrollbar-color:var(--accent) var(--line);-webkit-overflow-scrolling:touch;-webkit-mask-image:linear-gradient(#000 calc(100% - 28px),transparent);mask-image:linear-gradient(#000 calc(100% - 28px),transparent)}
.skills::-webkit-scrollbar,.acts::-webkit-scrollbar{width:6px}
.skills::-webkit-scrollbar-track,.acts::-webkit-scrollbar-track{background:var(--line);border-radius:99px}
.skills::-webkit-scrollbar-thumb,.acts::-webkit-scrollbar-thumb{background:var(--accent);border-radius:99px}
@media(max-width:700px){.skills{max-height:300px}.acts{max-height:340px}}
</style>
</head>
